{
  "$schema": "https://opencode.ai/config.json",
  "autoupdate": false,
  "theme": "kanagawa",
  "permission": {
    "bash": {
      "git *": "ask",
      "terraform *": "ask"
    },
    "edit": "allow",
    "external_directory": "ask"
  },
  "mcp": {
    "chrome-devtools": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "chrome-devtools-mcp@latest"
      ]
    }
  }
}
